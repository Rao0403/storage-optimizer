{
  "database_path": "%LOCALAPPDATA%\\StorageGenius\\storage-genius.db",
  "report_directory": "%USERPROFILE%\\Documents\\StorageGenius",
  "cleanup_rules": [
    {
      "name": "large-downloads",
      "source_dir": "%USERPROFILE%\\Downloads",
      "target_dir": "D:\\StorageGeniusBackup\\DownloadsArchive",
      "min_size_mb": 500,
      "keep_recent_hours": 24,
      "include_extensions": [],
      "exclude_extensions": [
        ".tmp",
        ".crdownload",
        ".part"
      ],
      "organize_by": "month"
    }
  ],
  "app_audit": {
    "unused_days": 30,
    "minimum_install_age_days": 45,
    "minimum_candidate_size_mb": 500,
    "score_thresholds": {
      "review_uninstall": 30,
      "likely_active": 65
    },
    "ignored_name_fragments": [
      "Security Update",
      "Update for",
      "Microsoft Visual C++",
      "Windows SDK",
      "Driver",
      "Redistributable"
    ]
  },
  "activitywatch": {
    "enabled": false,
    "base_url": "http://localhost:5600",
    "lookback_days": 30
  },
  "hotspot_scan": {
    "roots": [
      "%USERPROFILE%",
      "%LOCALAPPDATA%",
      "%APPDATA%",
      "%ProgramData%",
      "%TEMP%",
      "%SystemRoot%\\Temp",
      "C:\\Program Files",
      "C:\\Program Files (x86)"
    ],
    "exclude_paths": [
      "%LOCALAPPDATA%\\StorageGenius"
    ],
    "large_file_threshold_mb": 250,
    "max_depth": 4,
    "html_reports_to_keep": 10
  },
  "dev_cleanup": {
    "enabled": true,
    "node": {
      "enabled": true
    },
    "python": {
      "enabled": true
    },
    "extra_paths": [],
    "exclude_paths": [
      "%LOCALAPPDATA%\\StorageGenius"
    ]
  }
}
